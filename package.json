{
  "name": "@imhecateq/mcp-coolify",
  "version": "1.0.0",
  "description": "Production-grade Coolify MCP Server — manage Coolify infrastructure via Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-coolify": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepare": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "build:dashboard": "cd dashboard && npm install && npm run build",
    "build:all": "npm run build && npm run build:dashboard",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "coolify",
    "devops",
    "infrastructure",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hecateq/mcp-coolify.git"
  },
  "bugs": {
    "url": "https://github.com/hecateq/mcp-coolify/issues"
  },
  "homepage": "https://github.com/hecateq/mcp-coolify#readme",
  "author": {
    "name": "imhecateq",
    "url": "https://github.com/hecateq"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "fastify": "^5.10.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.0",
    "nock": "^14.0.0",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.1.0"
  }
}
