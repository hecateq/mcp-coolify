# ┌────────────────────────────────────────────────────────────────┐
# │              Coolify MCP Server Configuration                │
# │     All values shown are placeholders — replace with yours   │
# └────────────────────────────────────────────────────────────────┘

# ─── Required ────────────────────────────────────────────────────
# The base URL of your Coolify instance
COOLIFY_URL=https://coolify.example.com

# Fallback API token (used when scoped tokens are not set)
COOLIFY_API_TOKEN=

# ─── Scoped Tokens (Optional — overrides COOLIFY_API_TOKEN) ──────
# Token with read-only permissions for normal read operations
COOLIFY_READ_TOKEN=
# Token with read permissions including sensitive data
COOLIFY_SENSITIVE_TOKEN=
# Token with write permissions for env vars, settings changes
COOLIFY_WRITE_TOKEN=
# Token with deploy permissions
COOLIFY_DEPLOY_TOKEN=

# ─── Transport ───────────────────────────────────────────────────
# Transport mode: "stdio" (default) or "http"
MCP_TRANSPORT=stdio
# HTTP transport host
MCP_HTTP_HOST=0.0.0.0
# HTTP transport port
MCP_HTTP_PORT=3000
# API key for authenticating HTTP MCP requests (required for HTTP transport)
MCP_SERVER_API_KEY=

# ─── Operation Mode ──────────────────────────────────────────────
# "read-only" — Only GET operations allowed
# "deploy-only" — Read + deploy allowed, write denied
# "safe-write" — Read + deploy + explicitly enabled mutations
COOLIFY_OPERATION_MODE=read-only

# ─── Allowlist (Optional — restricts accessible resources) ───────
# Comma-separated list of project UUIDs
COOLIFY_ALLOWED_PROJECT_UUIDS=
# Comma-separated list of environment UUIDs
COOLIFY_ALLOWED_ENVIRONMENT_UUIDS=
# Comma-separated list of resource UUIDs
COOLIFY_ALLOWED_RESOURCE_UUIDS=

# ─── Production Protection ───────────────────────────────────────
# Environment names considered "production" (comma-separated)
COOLIFY_PRODUCTION_ENV_NAMES=production,prod
# Block ALL mutations on production environments
COOLIFY_DENY_PRODUCTION_MUTATIONS=true
# Allow deploy on production (if DENY_PRODUCTION_MUTATIONS is false)
COOLIFY_ALLOW_PRODUCTION_DEPLOY=false
# Allow stop operations (globally — default false)
COOLIFY_ALLOW_STOP=false
# Allow environment variable modifications
COOLIFY_ALLOW_ENV_WRITE=false

# ─── Dashboard ────────────────────────────────────────────────────
# Auto-start web dashboard when MCP starts (default: true)
MCP_DASHBOARD_ENABLED=true
# Dashboard host (default: 127.0.0.1 — localhost only)
MCP_DASHBOARD_HOST=127.0.0.1
# Dashboard port (default: 6489)
MCP_DASHBOARD_PORT=6489

# ─── Logging ─────────────────────────────────────────────────────
# Max log lines to return from application logs
COOLIFY_LOG_MAX_LINES=200
